# =============================================================================
# PRISM configuration. Copy to .env and adjust. Never commit the real .env.
# =============================================================================
# Every value here has a working default in docker-compose.yml except JWT_SECRET,
# which deliberately has none. The application refuses to start if the signing
# secret is missing or shorter than 32 characters, because a weak or shared
# secret makes every token the system has ever issued forgeable.
#
# Generate one with:
#   openssl rand -base64 48
# or, on Windows PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
# =============================================================================

# ---- database --------------------------------------------------------------
MYSQL_DATABASE=prism
DB_USERNAME=prism
DB_PASSWORD=change-me-before-any-shared-deployment
MYSQL_ROOT_PASSWORD=change-me-too
# Host port only. Inside the compose network the database is always reached as
# `mysql:3306`, so this never appears in the connection URL.
MYSQL_PORT=3307

# ---- published ports -------------------------------------------------------
# The frontend proxies the API, so the browser only ever needs FRONTEND_PORT.
# BACKEND_PORT is published for direct API access, and can be removed entirely
# outside development.
FRONTEND_PORT=5173
BACKEND_PORT=8080

# ---- security --------------------------------------------------------------
# Required. At least 32 characters. No default on purpose.
JWT_SECRET=

# Minimum password length. The application enforces this on registration and on
# admin-created users, and the demo seeder honours it.
SECURITY_PASSWORD_MIN_LENGTH=12

# Comma-separated allowed origins, or empty for same-origin only.
#
# Empty is the correct value whenever the frontend is served by the nginx
# container in docker-compose.yml, because the browser then makes no
# cross-origin request at all. Set it only when running the Vite dev server
# (npm run dev, which listens on 5173) against a backend on another origin.
CORS_ALLOWED_ORIGINS=

# ---- model provider --------------------------------------------------------
# `fake` is the offline deterministic provider. It produces real, schema-valid
# output with no network call, so the whole pipeline is demonstrable with no API
# key. It is not a stub in the sense of returning nothing: it performs genuine
# parsing, validation, quarantine, and persistence, and it is the reason the
# end-to-end tests are deterministic.
#
# Any OpenAI-compatible endpoint works by setting `openai` below.
LLM_PROVIDER=fake

# Used only when LLM_PROVIDER=openai.
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_API_KEY=
#LLM_MODEL=gpt-4o-mini

# ---- logging ---------------------------------------------------------------
# INFO in production. DEBUG records every LLM call and every trace step, which is
# exactly what the Glass Box is for but is far too noisy for normal running.
LOGGING_LEVEL_COM_PRISM=INFO

# ---- running the Vite dev server against a containerised backend -----------
# Only used by `npm run dev`; the proxy target in vite.config.ts reads it.
#VITE_API_PROXY_TARGET=http://localhost:8080
